# Copia este fichero a .env. Hace falta al menos una de las dos cuentas.

# Last.fm: https://www.last.fm/api/account/create
LASTFM_API_KEY=
LASTFM_USERNAME=

# ListenBrainz: el token solo hace falta si tus escuchas son privadas
LB_USERNAME=
LB_TOKEN=

# Contacto que se envía a MusicBrainz al pedir géneros (lo piden: un correo o una URL tuya)
MB_CONTACT=

# La sincronización diaria la lanza Ofelia (docker-compose.yml, 00:00). Si no usas
# Ofelia, aquí puedes pedir que el propio servicio sincronice cada N horas (0 = no)
SYNC_EVERY_HOURS=0
# Zona horaria de los trabajos programados (Ofelia)
TZ=Europe/Madrid

# Carpeta del anfitrión donde queda lastfm_stats.db (otros servicios la leen desde ahí)
DATOS=./datos
